# Copy this file to `.env.test.1445` and select it with:
# SMB2_ENV_FILE=.env.test.1445 dart run test/integration/bootstrap.dart
#
# This profile keeps the Samba container on the local 1445 endpoint used by
# the cross-platform integration harness while preserving SMB's container
# port 445 internally.
SMB2_HOST_PORT=1445
SMB2_SHARE=public
SMB2_USER=testuser
SMB2_PASS=testpass
